# 依赖
node_modules/
.pnpm-store/
.yarn/

# npm 本地缓存（沙箱环境下改用项目内缓存，避免写入用户目录）
.npm-cache/

# 构建产物
dist/
build/
out/
*.tsbuildinfo
*.tgz

# 环境变量与密钥（严禁提交）
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json

# 本地工作数据与工具目录（不进入代码仓库）
.learnbuddy/
.tmp/
.tmp_extract/

# 日志
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# 测试与覆盖率
coverage/
.nyc_output/

# 编辑器与系统文件
.vscode/*
!.vscode/extensions.json
.vs/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 录屏与视频素材（体积大，单独通过赛事渠道提交）
*.mp4
*.mov
