{
  "name": "@lc/server",
  "version": "0.1.0",
  "private": true,
  "description": "服务端：模型适配、会话管理、图谱落盘与十个接口",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --sourcemap --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.mjs",
    "verify:store": "tsx scripts/verify-knowledge-commit.mjs",
    "verify:errors": "tsx scripts/verify-error-mapping.mjs",
    "verify:guards": "tsx scripts/verify-guards-and-errors.mjs",
    "verify:graph": "tsx scripts/verify-graph-and-profile.mjs",
    "verify:symbolic": "tsx scripts/verify-symbolic.mjs",
    "verify:vision": "tsx scripts/verify-parse-vision.mjs",
    "verify:serve-web": "tsx scripts/verify-serve-web.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:flow": "tsx scripts/verify-ui-flow.mjs",
    "verify:all": "npm run verify:store && npm run verify:errors && npm run verify:guards && npm run verify:graph && npm run verify:symbolic && npm run verify:vision && npm run verify:teaching-materials",
    "smoke:model": "tsx src/model/smoke.ts",
    "smoke:model:selfcheck": "tsx src/model/smoke.ts selfcheck",
    "smoke:model:text": "tsx src/model/smoke.ts text",
    "smoke:model:structured": "tsx src/model/smoke.ts structured",
    "smoke:model:image": "tsx src/model/smoke.ts image",
    "smoke:model:deepseek": "tsx src/model/smoke.ts deepseek",
    "verify:teaching-materials": "tsx scripts/verify-teaching-materials.mjs"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "^0.3.259",
    "dotenv": "^16.4.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@lc/contracts": "*",
    "@lc/teaching": "*"
  }
}
