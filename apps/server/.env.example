# ⚠️ 本文件是范例模板，会随仓库一起提交、评委可见 —— 请勿在此填入真实密钥，只保留空值。
# 实际使用时：cp .env.example .env，再把值填进 .env。
# .env 已被 .gitignore 排除，不会被提交。

# ===== 模型适配器选择 =====
# auto（默认）：有密钥走真实模型，无密钥自动降级为 mock
# mock：强制 mock，不调用真实模型（A 可无密钥独立开发前端）
# sdk：强制真实模型；无密钥时不静默降级，避免误把 mock 当成真实能力
MODEL_PROVIDER=auto

# ===== 模型推理（仅服务端使用，绝不下发到前端）=====
# 调用方式：CodeBuddy Agent SDK（@tencent-ai/agent-sdk），文字与图片调用均已实测通过。
# 认证由 SDK 读取下列环境变量完成，因此这里没有 BASE_URL；
# 也**没有固定模型名** —— 模型由上游动态分配
# （同日实测 hy3 / glm-5.3 / minimax-m3 三个不同结果，只能从响应里回读）。
CODEBUDDY_API_KEY=
CODEBUDDY_INTERNET_ENVIRONMENT=internal

# ===== 服务端 =====
PORT=3000
NODE_ENV=development

# 模型请求超时（毫秒），对应说明书 5.3 的 60 秒约束
MODEL_TIMEOUT_MS=60000
