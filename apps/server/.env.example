# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，严禁提交真实密钥

# ===== 模型推理接口（仅服务端使用，绝不下发到前端）=====
# 留空或保持 mock 时自动使用 mock 适配器，前端可独立开发
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# ===== 服务端 =====
PORT=3000
NODE_ENV=development

# 模型请求超时（毫秒），对应说明书 5.3 的 60 秒约束
MODEL_TIMEOUT_MS=60000
